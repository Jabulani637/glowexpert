# Database
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_SSL=true

# Supabase Storage
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=glowexpert-storage

# Storage Provider (supabase or s3)
STORAGE_PROVIDER=supabase

# S3 Configuration (if using S3)
S3_REGION=eu-west-3
S3_ENDPOINTS=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Authentication
JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d
SESSION_SECRET=<SESSION_SECRET>

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_YourClerkSecretKeyHere # Get from Clerk dashboard > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere # Get from Clerk dashboard > API Keys

# SMTP (for Admin OTP Login Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=GlowExpert <noreply@glowexpert.com>

# CORS Configuration
FRONTEND_URL=https://glowexpert.vercel.app
CORS_ALLOWED_ORIGINS=https://glowexpert.vercel.app
BACKEND_URL=https://your-backend-url.onrender.com

# PayFast Payment Integration
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Admin Account (for legacy admin seeding)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_CELLPHONE=

# Server Configuration
NODE_ENV=production
PORT=8081
BACKEND_PORT=8081
